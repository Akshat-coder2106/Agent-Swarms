SENTINEL_ENV=development
SENTINEL_AUTH_SECRET=replace-with-a-long-random-string
SENTINEL_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://agent-swarms-2.vercel.app
SENTINEL_ALLOWED_REPO_ROOTS=.
SENTINEL_ENABLE_LANGGRAPH=true
SENTINEL_ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_API_KEY=
# Production (Vercel): set these in Vercel Environment Variables
VITE_SENTINEL_API_URL=https://agent-swarms-2.onrender.com
VITE_DEFAULT_REPO_PATH=examples/python-vulnerable-api
# Local dev:
# VITE_SENTINEL_API_URL=http://127.0.0.1:8000
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
SENTINEL_LLM_PROVIDER=auto
SENTINEL_SESSION_DB=
SENTINEL_POLICY_CONFIDENCE_THRESHOLD=0.92
AZURE_DEVOPS_ORG=demo-org
AZURE_DEVOPS_PROJECT=ProjectSentinel
AZURE_DEVOPS_PAT=
